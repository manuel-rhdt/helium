Program = { WHITESPACE* ~ Form+ ~ WHITESPACE* }

Form = _{ Number | String | Ident | List }

List = { "(" ~ Form* ~ ")" }

Ident = @{ (Initial ~ Subsequent*) | "+" | "-" | "..." }

Initial = _{ CASED_LETTER | "!" | "$" | "%" | "&" | "*" | "/" | ":" | "<" | ">" | "?" | "~" | "_" | "^" }
Subsequent = _{ Initial | ASCII_DIGIT | "." | "+" | "-" }

Number = @{
    "-"?
    ~ ("0" | ASCII_NONZERO_DIGIT ~ ASCII_DIGIT*)
    ~ ("." ~ ASCII_DIGIT*)?
    ~ (^"e" ~ ("+" | "-")? ~ ASCII_DIGIT+)?
}
String = ${ "\"" ~ Inner ~ "\"" }
Inner = @{ Char* }
Char = {
    !("\"" | "\\") ~ ANY
    | "\\" ~ ("\"" | "\\" | "/" | "b" | "f" | "n" | "r" | "t")
    | "\\" ~ ("u" ~ ASCII_HEX_DIGIT{4})
}

WHITESPACE = _{ " " | "\t" | "\n" }

